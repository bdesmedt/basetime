# Kopieer dit bestand naar ".env" voor lokaal testen (dat bestand wordt NIET meegepusht
# naar git — zie .gitignore). Op Railway zet je dezelfde variabelen onder "Variables"
# in de project-instellingen, niet in een bestand.

# --- Odoo-verbinding (verplicht) --------------------------------------------
ODOO_URL=https://basetimebv.odoo.com
ODOO_DB=basetimebv
ODOO_USERNAME=jouw-odoo-inlogmail@basetime.nl
ODOO_API_KEY=plak-hier-je-odoo-api-sleutel

# --- Dashboard-beveiliging (verplicht) --------------------------------------
DASHBOARD_USER=bart
DASHBOARD_PASSWORD=kies-een-sterk-wachtwoord

